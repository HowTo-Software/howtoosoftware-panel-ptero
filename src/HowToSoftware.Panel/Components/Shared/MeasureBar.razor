@*
    A measure drawn as a bar.

    An unlimited resource draws no bar at all. A bar implies a ceiling, and Pterodactyl uses 0
    to mean unlimited - rendering that as a full bar tells an operator a server is out of memory
    when it has no memory limit.
*@

@if (Value.IsUnlimited)
{
    <p class="unlimited">Unlimited</p>
}
else
{
    <div class="bar @ToneClass @(Value.Fraction > 0.9 ? "is-near-limit" : null)"
         role="img"
         aria-label="@AriaLabel">
        <span class="bar-fill" style="--fill: @Percent%"></span>
    </div>
}

@code {
    /// <summary>How the bar is coloured.</summary>
    public enum BarTone
    {
        /// <summary>Neutral technical reading.</summary>
        Info,

        /// <summary>Brand emphasis, for the headline figure on a screen.</summary>
        Brand,
    }

    /// <summary>The measure to draw.</summary>
    [Parameter, EditorRequired]
    public Measure Value { get; set; }

    /// <summary>How to colour it.</summary>
    [Parameter]
    public BarTone Tone { get; set; } = BarTone.Info;

    /// <summary>What a screen reader is told.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    private string ToneClass => Tone is BarTone.Brand ? "is-brand" : "is-info";

    // Clamped for the fill only - the caller still sees the true fraction, and the near-limit
    // class fires off the real value, so a container over its soft limit still reads as over.
    private string Percent =>
        ((Value.Fraction ?? 0) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) is var raw
        && Value.Fraction > 1 ? "100" : raw;
}
