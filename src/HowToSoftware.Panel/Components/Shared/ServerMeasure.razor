@*
    One resource reading on a server card: the label, the figure, the ceiling, and a bar.

    A null measure is "not reporting", drawn as an em dash. It is never drawn as zero - a server
    whose daemon has gone quiet and a server sitting idle are different problems.
*@

<div class="cell">
    <dt class="cell-key">@Label</dt>
    @if (Value is { } measure)
    {
        <dd class="cell-value">
            @Display(measure)
            @if (!measure.IsUnlimited)
            {
                <span class="cell-limit">of @DisplayLimit(measure)</span>
            }
        </dd>
        <MeasureBar Value="measure" AriaLabel="@($"{Label}: {Display(measure)}")" />
    }
    else
    {
        <dd class="cell-value cell-value--absent" title="Not reporting">—</dd>
    }
</div>

@code {
    /// <summary>How the figure is formatted.</summary>
    public enum MeasureKind
    {
        /// <summary>A byte count.</summary>
        Bytes,

        /// <summary>A percentage of one CPU thread.</summary>
        Percent,
    }

    /// <summary>The row label.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The reading, or null when the server is not reporting.</summary>
    [Parameter]
    public Measure? Value { get; set; }

    /// <summary>How to format it.</summary>
    [Parameter]
    public MeasureKind Kind { get; set; } = MeasureKind.Bytes;

    private string Display(Measure m) =>
        Kind is MeasureKind.Bytes ? Format.Bytes(m.Used) : $"{m.Used}%";

    private string DisplayLimit(Measure m) =>
        Kind is MeasureKind.Bytes ? Format.Bytes(m.Limit) : $"{m.Limit}%";
}
