parameters:
	ignoreErrors:
		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: app/Console/Commands/UpgradeCommand.php

		-
			message: '#^Method Pterodactyl\\Http\\Controllers\\Api\\Client\\Servers\\ScheduleController\:\:createPrimaryTask\(\) should return Pterodactyl\\Models\\Task but returns bool\|Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/Api/Client/Servers/ScheduleController.php

		-
			message: '#^Property Pterodactyl\\Http\\Controllers\\Api\\Client\\Servers\\SubuserController\:\:\$revocationRepository is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: app/Http/Controllers/Api/Client/Servers/SubuserController.php

		-
			message: '#^Call to an undefined method Laravel\\Socialite\\Contracts\\Provider\:\:setScopes\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/Auth/OAuthController.php

		-
			message: '#^Unsafe access to private property Pterodactyl\\Http\\Middleware\\SetSecurityHeaders\:\:\$headers through static\:\:\.$#'
			identifier: staticClassAccess.privateProperty
			count: 1
			path: app/Http/Middleware/SetSecurityHeaders.php

		-
			message: '#^Call to an undefined method Pterodactyl\\Repositories\\Wings\\DaemonRepository\:\:deauthorize\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Jobs/RevokeSftpAccessJob.php

		-
			message: '#^Unsafe access to private property Pterodactyl\\Models\\ActivityLog\:\:\$identifierDataColumn through static\:\:\.$#'
			identifier: staticClassAccess.privateProperty
			count: 1
			path: app/Models/ActivityLog.php

		-
			message: '#^Unsafe access to private property Pterodactyl\\Models\\ActivityLog\:\:\$identifierPrefix through static\:\:\.$#'
			identifier: staticClassAccess.privateProperty
			count: 1
			path: app/Models/ActivityLog.php

		-
